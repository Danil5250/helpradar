<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базова тема застосунку -->
    <style name="Theme.HelpRadar" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Системна тема запуску: замінює зеленого андроїда на лелеку та пісочний фон -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/desert_sand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/img_mascot_boxes</item>
        <item name="postSplashScreenTheme">@style/Theme.HelpRadar</item>
    </style>
</resources>